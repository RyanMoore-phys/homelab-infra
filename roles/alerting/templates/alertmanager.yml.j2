# Managed by Ansible (alerting role). Read by the alertmanager container.
# Every alert goes to the owner's phone through ntfy on the gateway; ntfy's
# built-in "alertmanager" template turns the JSON into a readable message.
route:
  receiver: phone
  group_by: [alertname, instance]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 12h
  routes:
    # The always-on Watchdog alert, every 5 minutes, to a topic no phone
    # follows: the gateway's watchdog reports when it stops arriving.
    - matchers: ['alertname="Watchdog"']
      receiver: heartbeat
      group_wait: 0s
      group_interval: 1m
      repeat_interval: 5m
    - matchers: ['severity="critical"']
      receiver: phone-urgent

receivers:
  - name: phone
    webhook_configs:
      - url: "{{ alerting_ntfy_url }}/{{ ntfy_alert_topic }}?template=alertmanager"
        send_resolved: true
        http_config:
          authorization: {type: Bearer, credentials_file: /etc/alertmanager/ntfy_token}
  - name: phone-urgent
    webhook_configs:
      - url: "{{ alerting_ntfy_url }}/{{ ntfy_alert_topic }}?template=alertmanager&priority=high"
        send_resolved: true
        http_config:
          authorization: {type: Bearer, credentials_file: /etc/alertmanager/ntfy_token}
  - name: heartbeat
    webhook_configs:
      - url: "{{ alerting_ntfy_url }}/{{ ntfy_heartbeat_topic }}?template=alertmanager"
        send_resolved: false
        http_config:
          authorization: {type: Bearer, credentials_file: /etc/alertmanager/ntfy_token}
